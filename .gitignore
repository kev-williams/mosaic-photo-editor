*.[pP][sS][dD]
*.[dD][nN][gG]
*.[cC][rR][23]
*.[nN][eE][fF]
*.[aA][rR][wW]
*.[rR][aA][fF]
*.[oO][rR][fF]
*.[rR][wW]2
