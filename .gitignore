*.[jJ][pP][eE][gG]
*.[pP][nN][gG]
*.[gG][iI][fF]
*.[wW][eE][bB][pP]
*.[aA][vV][iI][fF]
*.[hH][eE][iI][cC]
*.[hH][eE][iI][fF]
*.[tT][iI][fF]
*.[tT][iI][fF][fF]
*.[bB][mM][pP]
*.[sS][vV][gG]
