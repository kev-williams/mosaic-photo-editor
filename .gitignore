# ----------------------------------------------------------------------------------------------
# ALLOWLIST. Everything is ignored unless it is listed below.
# Photos, exports, models, settings and anything new can never be committed by accident.
# Adding a source file? List it here on purpose. (See CONTRIBUTING.md.)
# ----------------------------------------------------------------------------------------------
*
!*/

# Project files
!/.gitignore
!/.gitattributes
!/.dockerignore
!/README.md
!/LICENSE
!/THIRD_PARTY_NOTICES.md
!/CHANGELOG.md
!/CONTRIBUTING.md
!/CODE_OF_CONDUCT.md
!/SECURITY.md
!/ruff.toml
!/requirements.txt
!/requirements-ai.txt
!/requirements-dev.txt

# App
!/app.py
!/launcher.py
!/mosaic/*.py
!/mosaic/ui/*.py
!/.streamlit/config.toml

# Scripts, Docker, tests, GitHub
!/scripts/*.sh
!/.githooks/pre-commit
!/docker/Dockerfile
!/docker/docker-compose.yml
!/docker/env.example
!/tests/*.py
!/.github/workflows/*.yml
!/.github/ISSUE_TEMPLATE/*.md
!/.github/ISSUE_TEMPLATE/config.yml
!/.github/PULL_REQUEST_TEMPLATE.md

# ----------------------------------------------------------------------------------------------
# NEVER, even if a rule above would include them: media, photos, raw files, data, secrets.
# ----------------------------------------------------------------------------------------------
